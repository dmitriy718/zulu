{
  "name": "@zulu/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "node .next/standalone/apps/web/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
